# ============================================================
# AeroGo 24 — App Chauffeur (Expo)
# Copier ce fichier en .env et remplir les valeurs
# NE PAS commiter le fichier .env
# ============================================================

# ─── API Backend ────────────────────────────────────────────
# Laisser vide pour activer le mode mock (développement sans backend)
EXPO_PUBLIC_API_URL=https://aerocab-api-d1u6.onrender.com/api

# ─── Clé d'accès /config ────────────────────────────────────
# Doit correspondre à APP_KEY dans le backend
EXPO_PUBLIC_APP_KEY=

# ─── Google Maps ────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
